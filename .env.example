# =============================================================================
# MCP-сервер — конфигурация (копировать в .env рядом с местом запуска)
# =============================================================================
# Это САМОСТОЯТЕЛЬНЫЙ сервис — отдельный процесс, отдельная база данных,
# отдельный деплой от AgentsCore и AgentsApp. Ничего из .env AgentsCore
# сюда не переносится автоматически.

# --- Сеть -------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8001

# --- Включаемые возможности -----------------------------------------------------
# Пока настройка не задана (или false) — инструменты группы НЕ попадают в
# список доступных: ни агенту (AgentsCore, MCP tools/list), ни в приложение
# (AgentsApp, GET /api/tools). Инструменты Git-хостингов (git_host_*)
# доступны всегда.
#
# Локальный Git — работа с рабочими копиями репозиториев НА МАШИНЕ этого
# сервера: execute_git_command (произвольная git-команда!) и git_pull.
# Включайте, только если это действительно нужно.
MCP_LOCAL_GIT_ENABLED=false
#
# HTTP-запросы — инструмент http_fetch: произвольный HTTP-запрос с машины
# сервера (в том числе во внутреннюю сеть). Включайте осознанно.
MCP_HTTP_FETCH_ENABLED=false
#
# Интернет поиск — duckduckgo_search («Поиск в DuckDuckGo», библиотека ddgs:
# неофициальная, при частых запросах DuckDuckGo ограничивает частоту) и
# read_web_page («Чтение страницы»: текст и ссылки страницы; во внутреннюю
# сеть не ходит).
MCP_WEB_SEARCH_ENABLED=false
#
# Обработка LLM — инструмент summarize («Суммарный ответ»). Работает только
# при заданном MCP_LLM_API_KEY (см. ниже).
MCP_LLM_ENABLED=false
#
# Работа с файлами — инструмент save_to_text_file («Сохранить в текстовый
# файл»): запись .md/.txt/.csv/.json/.log только внутри MCP_FILES_DIR.
MCP_FILES_ENABLED=false
#
# Цепочка инструментов (run_pipeline, группа «Пайплайны») и Git-хостинги
# доступны всегда. Периодические задачи — в отдельном сервисе планировщика.

# --- Интернет поиск: DuckDuckGo -----------------------------------------------------------------
# Поисковик внутри ddgs: duckduckgo; можно список через запятую или auto
# (тогда ddgs сама выбирает среди доступных поисковиков).
MCP_DDGS_BACKEND=duckduckgo
MCP_DDGS_REGION=ru-ru
MCP_DDGS_TIMEOUT=15

# --- LLM для «Суммарного ответа» (OpenAI-совместимый API) ---------------------
MCP_LLM_BASE_URL=https://api.deepseek.com
MCP_LLM_API_KEY=
MCP_LLM_MODEL=deepseek-v4-flash
MCP_LLM_TIMEOUT=120
MCP_LLM_MAX_TOKENS=2000

# --- Файлы и промежуточные результаты -----------------------------------------
# Каталог сохраняемых файлов (приложение показывает их в разделе «Файлы»).
MCP_FILES_DIR=mcp_files
# Промежуточные результаты шагов (result_id) и срок их хранения, часов.
MCP_DATA_DIR=mcp_data
MCP_RESULT_TTL_HOURS=24

# --- Аутентификация (заготовка) ----------------------------------------------
# Пока НЕ используется нигде в коде (аутентификация между сервисами не
# реализована по этому ТЗ) — оставлено пустым нарочно, чтобы включить
# проверку ключа позже без изменения структуры конфигурации ни здесь, ни
# в AgentsCore (MCP_API_KEY), ни в AgentsApp.
MCP_API_KEY=

# --- Git-хостинги -------------------------------------------------------------
# Токен не задан -> провайдер работает в анонимном режиме: доступны только
# публичные репозитории, лимит запросов в час намного ниже (у GitHub,
# например, 60 против 5000 с токеном). Это штатный режим, не ошибка.
# Токены НИКОГДА не пишутся в лог (см. server.py/git_hosts/*).

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

GITEA_TOKEN=
# Свой self-hosted Gitea -> укажите его API URL, например:
# GITEA_API_URL=https://git.example.com/api/v1
GITEA_API_URL=https://gitea.com/api/v1

# Таймаут HTTP-запросов к Git-хостингам и внутри действия http_fetch (секунды).
MCP_HTTP_TIMEOUT=30

# --- Логирование ---------------------------------------------------------------
# DEBUG/INFO/WARNING/ERROR
MCP_LOG_LEVEL=INFO
# Пусто -> лог в stdout. Иначе -> путь к файлу.
MCP_LOG_FILE=
